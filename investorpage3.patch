+import { useEffect, useMemo, useRef, useState } from 'react'
+import { motion, useInView } from 'framer-motion'
+import {
+  TrendingUp,
+  BarChart3,
+  Target,
+  UserPlus,
+  ArrowUpRight,
+  Activity,
+} from 'lucide-react'
+import { Card } from '@/components/ui/Card'
+import { metricsData, type MetricDatum } from '@/utils/constants'
+import { useCounterAnimation } from '@/hooks/useCounterAnimation'
+
+const iconMap = {
+  TrendingUp,
+  BarChart3,
+  Target,
+  UserPlus,
+  ArrowUpRight,
+  Activity,
+}
+
+const containerVariants = {
+  hidden: { opacity: 0 },
+  show: {
+    opacity: 1,
+    transition: {
+      staggerChildren: 0.18,
+    },
+  },
+}
+
+const itemVariants = {
+  hidden: { opacity: 0, y: 24 },
+  show: { opacity: 1, y: 0, transition: { duration: 0.5, ease: 'easeOut' } },
+}
+
+const parseMetricValue = (value: string) => {
+  const numeric = parseFloat(value.replace(/[^0-9.]/g, ''))
+  const isPercentage = value.trim().endsWith('%')
+  return { numeric, isPercentage }
+}
+
+const AnimatedValue = ({ datum, shouldAnimate }: { datum: MetricDatum; shouldAnimate: boolean }) => {
+  const { numeric, isPercentage } = useMemo(() => parseMetricValue(datum.value), [datum.value])
+  const animatedValue = useCounterAnimation(shouldAnimate ? numeric : 0)
+
+  if (Number.isNaN(numeric)) {
+    return <span className="stat-value">{datum.value}</span>
+  }
+
+  return (
+    <span className="stat-value">
+      {animatedValue}
+      {isPercentage ? '%' : ''}
+    </span>
+  )
+}
+
+export const Metrics = () => {
+  const sectionRef = useRef<HTMLDivElement>(null)
+  const isInView = useInView(sectionRef, { once: true, amount: 0.3 })
+  const [animated, setAnimated] = useState(false)
+
+  useEffect(() => {
+    if (isInView && !animated) {
+      setAnimated(true)
+    }
+  }, [isInView, animated])
+
+  return (
+    <section id="metrics" ref={sectionRef} className="section-padding">
+      <div className="container-boundary flex flex-col gap-12">
+        <div className="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
+          <div className="space-y-4">
+            <span className="badge">Proof &gt; Promises</span>
+            <h2 className="section-heading">Cohort metrics that outperform legacy fitness apps</h2>
+            <p className="section-subheading">
+              Network density and habit-forming design drive enterprise-level retention from day one cohorts.
+            </p>
+          </div>
+          <div className="rounded-card border border-white/10 bg-white/5 px-5 py-4 text-sm text-white/70 shadow-subtle md:max-w-sm">
+            <div className="flex items-center gap-2 text-white">
+              <Activity className="h-4 w-4 text-energy" />
+              <span className="uppercase tracking-[0.3em] text-xs text-white/60">Investor Snapshot</span>
+            </div>
+            <p className="mt-3 text-sm leading-relaxed text-white/70">
+              Results validated across 14 pilot groups. Data instrumented via Discord + TestFlight instrumentation.
+            </p>
+          </div>
+        </div>
+
+        <motion.div
+          variants={containerVariants}
+          initial="hidden"
+          animate={animated ? 'show' : 'hidden'}
+          className="grid gap-6 md:grid-cols-2 xl:grid-cols-4"
+        >
+          {metricsData.map((metric) => {
+            const Icon = iconMap[metric.icon]
+            return (
+              <motion.div key={metric.label} variants={itemVariants}>
+                <Card className="h-full bg-gradient-to-br from-white/10 via-white/5 to-transparent p-6">
+                  <div className="flex items-center justify-between">
+                    <p className="text-sm font-medium text-white/60">{metric.label}</p>
+                    <span
+                      className={`flex items-center gap-1 rounded-full px-3 py-1 text-xs uppercase tracking-[0.3em] ${
+                        metric.trend === 'up'
+                          ? 'bg-energy/20 text-energy'
+                          : metric.trend === 'down'
+                            ? 'bg-urgency/20 text-urgency'
+                            : 'bg-white/10 text-white/70'
+                      }`}
+                    >
+                      {metric.trend === 'up' ? '▲' : metric.trend === 'down' ? '▼' : '■'}
+                      <span>{metric.trend}</span>
+                    </span>
+                  </div>
+                  <div className="mt-6 flex items-end justify-between">
+                    <div>
+                      <AnimatedValue datum={metric} shouldAnimate={animated} />
+                      <p className="text-sm text-white/50">{metric.description}</p>
+                    </div>
+                    <div className="rounded-full bg-white/10 p-3 text-primary">
+                      <Icon className="h-5 w-5" />
+                    </div>
+                  </div>
+                  {metric.benchmark && (
+                    <p className="mt-6 text-xs font-medium uppercase tracking-[0.2em] text-white/50">
+                      {metric.benchmark}
+                    </p>
+                  )}
+                  {metric.growth && <p className="mt-2 text-sm text-energy">{metric.growth}</p>}
+                </Card>
+              </motion.div>
+            )
+          })}
+        </motion.div>
+      </div>
+    </section>
+  )
+}
