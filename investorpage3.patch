diff --git a/wefit-investors/src/App.tsx b/wefit-investors/src/App.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0d38eae34e9e45d9e6f38febfc98fc785e03f6f8
--- /dev/null
+++ b/wefit-investors/src/App.tsx
@@ -0,0 +1,97 @@
+import { lazy, Suspense, useEffect, useMemo, useState } from 'react'
+import { Helmet } from 'react-helmet-async'
+import { Hero } from '@/components/sections/Hero'
+import { Metrics } from '@/components/sections/Metrics'
+import { Problem } from '@/components/sections/Problem'
+import { Solution } from '@/components/sections/Solution'
+import { Team } from '@/components/sections/Team'
+import { Contact } from '@/components/sections/Contact'
+import { Header } from '@/components/layout/Header'
+import { Footer } from '@/components/layout/Footer'
+import { heroContent, type HeroVariant } from '@/utils/constants'
+import { initializeAnalytics } from '@/utils/analytics'
+
+const Traction = lazy(() => import('@/components/sections/Traction').then((module) => ({ default: module.Traction })))
+const BusinessModel = lazy(() =>
+  import('@/components/sections/BusinessModel').then((module) => ({ default: module.BusinessModel })),
+)
+
+const VariantToggle = ({ active, onChange }: { active: HeroVariant; onChange: (variant: HeroVariant) => void }) => (
+  <div className="fixed right-4 top-28 z-40 hidden flex-col gap-2 rounded-card border border-white/10 bg-black/70 p-3 text-xs text-white/70 shadow-subtle lg:flex">
+    <span className="uppercase tracking-[0.3em] text-white/40">Hero Variant</span>
+    {(['numbers', 'narrative', 'distribution'] as HeroVariant[]).map((variant) => (
+      <button
+        key={variant}
+        type="button"
+        onClick={() => onChange(variant)}
+        aria-pressed={active === variant}
+        className={`rounded-button px-3 py-2 text-left font-medium transition ${
+          active === variant ? 'bg-primary text-white shadow-subtle' : 'hover:bg-white/10'
+        }`}
+      >
+        {heroContent[variant].headline}
+      </button>
+    ))}
+  </div>
+)
+
+const SuspenseFallback = () => (
+  <div className="section-padding">
+    <div className="container-boundary">
+      <div className="animate-pulse space-y-4">
+        <div className="h-8 w-1/3 rounded bg-white/10" />
+        <div className="h-6 w-2/3 rounded bg-white/10" />
+        <div className="h-60 rounded bg-white/5" />
+      </div>
+    </div>
+  </div>
+)
+
+const App = () => {
+  const [heroVariant, setHeroVariant] = useState<HeroVariant>('numbers')
+
+  useEffect(() => {
+    initializeAnalytics()
+  }, [])
+
+  const pageTitle = useMemo(() => `weFit Labs — ${heroContent[heroVariant].headline}`, [heroVariant])
+
+  return (
+    <div className="relative min-h-screen">
+      <Helmet>
+        <title>{pageTitle}</title>
+        <meta
+          name="description"
+          content="Building the social layer for fitness communities. Active groups, sticky challenges, compounding referrals."
+        />
+        <meta property="og:title" content="weFit Labs - Investor Overview" />
+        <meta
+          property="og:description"
+          content="The definitive social fitness platform with proven network effects and clear monetization strategy."
+        />
+        <meta property="og:type" content="website" />
+        <meta property="og:url" content="https://investors.wefitlabs.com" />
+        <meta name="twitter:card" content="summary_large_image" />
+      </Helmet>
+      <Header heroVariant={heroVariant} />
+      <main className="flex flex-col">
+        <Hero variant={heroVariant} />
+        <Metrics />
+        <Problem />
+        <Solution />
+        <Suspense fallback={<SuspenseFallback />}>
+          <Traction />
+        </Suspense>
+        <Suspense fallback={<SuspenseFallback />}>
+          <BusinessModel />
+        </Suspense>
+        <Team />
+        <Contact />
+      </main>
+      <Footer />
+      <VariantToggle active={heroVariant} onChange={setHeroVariant} />
+    </div>
+  )
+}
+
+export default App
