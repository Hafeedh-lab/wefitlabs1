@@ -0,0 +1,67 @@
+export type GTagFunction = (...args: unknown[]) => void
+
+const getWindowGtag = (): GTagFunction | undefined => {
+  if (typeof window === 'undefined') {
+    return undefined
+  }
+
+  const { gtag } = window as typeof window & {
+    gtag?: GTagFunction
+  }
+
+  return gtag
+}
+
+export const initializeAnalytics = (): void => {
+  if (typeof window === 'undefined') return
+  const measurementId = import.meta.env.VITE_GA_MEASUREMENT_ID as string | undefined
+  if (!measurementId) return
+
+  const gtagScript = document.createElement('script')
+  gtagScript.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`
+  gtagScript.async = true
+  document.head.appendChild(gtagScript)
+
+  window.dataLayer = window.dataLayer || []
+  function gtag(...args: unknown[]) {
+    window.dataLayer?.push(args)
+  }
+  gtag('js', new Date())
+  gtag('config', measurementId)
+
+  ;(window as typeof window & { gtag?: GTagFunction }).gtag = gtag
+}
+
+export const gtag = (
+  action: string,
+  target: string,
+  params?: Record<string, unknown>,
+): void => {
+  const gtagFn = getWindowGtag()
+  if (!gtagFn) return
+
+  gtagFn('event', action, {
+    event_category: target,
+    ...params,
+  })
+}
+
+export const trackCta = (action: string, label: string): void => {
+  gtag('cta_click', action, {
+    event_label: label,
+    value: 1,
+  })
+}
+
+export const trackFormSubmit = (formType: string): void => {
+  gtag('form_submit', 'Lead', {
+    event_label: formType,
+  })
+}
+
+declare global {
+  interface Window {
+    dataLayer?: unknown[]
+    gtag?: GTagFunction
+  }
+}
